# ==============================================================================
# TraceX Cyber-Forensic Threat Defense — Environment Configuration
# Storage Engine: Pure AWS S3 (No databases)
# ==============================================================================

# AWS Authentication (Required for live AWS S3 storage)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_SESSION_TOKEN=

# AWS S3 Dedicated Buckets
S3_RAW_EML_BUCKET=tracex-raw-eml
S3_RENDERS_PNG_BUCKET=tracex-renders-png
S3_EVIDENCE_BUCKET=tracex-evidence-ledger
S3_CERTIFICATES_BUCKET=tracex-certificates-65b

# Optional Custom S3 Endpoint (Leave empty for live AWS S3; use http://localhost:4566 for LocalStack)
AWS_ENDPOINT_URL=

# Section 65B Statutory Legal Attestation Identity
CERTIFIER_NAME=Security Analyst / TraceX Custodian
CERTIFIER_TITLE=Lead Cyber-Forensic Investigator & Systems Custodian
ORGANIZATION=TraceX Cyber Threat Defense Command

{
  "manifest_version": 3,
  "name": "TraceX - Email Threat Sentinel",
  "version": "2.0",
  "description": "Real-time AI email threat triage and forensic escalation powered by TraceX.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "http://13.200.242.110/*",
    "http://13.200.242.110:8000/*",
    "http://13.200.242.110:8002/*",
    "http://ec2-13-200-242-110.ap-south-1.compute.amazonaws.com/*",
    "http://ec2-13-200-242-110.ap-south-1.compute.amazonaws.com:8000/*",
    "https://*.amazonaws.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8002/*",
    "http://127.0.0.1:8002/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["config.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
